\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Pooled pointwise fidelity over 8,172 windows, each the per-window global metric averaged over the three axes. MAE is reported as mean$\pm $standard deviation across windows (m/s\(^2\)); MSE (m\(^2\)/s\(^4\)) and Pearson (dimensionless) are pooled means. MSE for the near-original trio is given to five decimals, because RP and GADF agree to four.}}{10}{}\protected@file@percent }
\newlabel{tab:pointwise_pooled}{{2}{10}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}Robustness to image perturbation}{10}{}\protected@file@percent }
\newlabel{sec:results_robustness}{{6.3}{10}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Range-normalised and spectral fidelity over 8,172 windows (mean\(\pm \)std across windows, averaged over the three axes). PSD-shape distance compares Welch spectra after each is normalised to unit mass; energy and band-mass errors are reported separately in the Supplementary Material.}}{11}{}\protected@file@percent }
\newlabel{tab:fidelity_spectral}{{3}{11}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Controlled local-stability test: NMAE under zero-mean Gaussian pixel noise (standard deviation \(\sigma \), out of 255). Values are mean$\pm $standard deviation across 150 activity-balanced, subject-spread windows after averaging two independent draws per nonzero level. Subject-cluster 95\% intervals are in the Supplementary Material.}}{11}{}\protected@file@percent }
\newlabel{tab:robustness}{{4}{11}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Reconstruction NMAE by source over the 150 activity-balanced robustness windows: native float operator mean, and mean$\pm $standard deviation for the clean and perturbed PNG conditions. RP, GASF, and GADF are exact to numerical precision in floating point, so their clean error is entirely 8-bit quantisation; MTF is already lossy before storage.}}{11}{}\protected@file@percent }
\newlabel{tab:error_sources}{{5}{11}{}{}{}}
