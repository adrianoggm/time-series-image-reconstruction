\newlabel{sec:subject_out_results}{{6.4}{11}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Grouped subject-out three-fold accuracy (primary protocol) for three representative classifiers spanning the families (convolutional, recurrent, classical). Accuracies are rounded to three decimals; the sub-$0.001$ per-method differences are quantified per subject in Table~\ref {tab:equivalence_ci}. All six classifiers and the window-level comparison are in the Supplementary Material.}}{11}{}\protected@file@percent }
\newlabel{tab:subject_out_acc}{{6}{11}{}{}{}}
