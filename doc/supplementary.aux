\newlabel{sec:disc_rp_gadf_overlap}{{S13.1}{14}{Null-Corrected RP/GADF Regional Overlap}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S18}{\ignorespaces Null-corrected RP/GADF structural-overlap diagnostic. The top panel shows one 5-bin visual comparison: quantised RP, aligned quantised GADF, and pixels landing in the same bin. The middle histograms compare matched RP/GADF pairs against same-activity random pairings. The bottom row shows that matched regional overlap remains above the null baseline across independent visual quantisation levels \(B\in \{3,5,7,9,12,15\}\), while the distribution-only factor stays close to one.}}{14}{}\protected@file@percent }
\newlabel{fig:rp_gadf_structure_overlap}{{S18}{14}{Null-Corrected RP/GADF Regional Overlap}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S15}{\ignorespaces Null-corrected RP/GADF weighted regional overlap across visual intensity bins. Values are averaged over grayscale and the three axis channels. The null baseline pairs each RP image with a GADF image from a different window of the same activity class. Jaccard values are percentages; the Matched/null factor is the mean over the four channels of the per-channel matched/null ratio, so it is not the ratio of the two displayed column means.}}{15}{}\protected@file@percent }
\newlabel{tab:rp_gadf_region_overlap}{{S15}{15}{Null-Corrected RP/GADF Regional Overlap}{}{}}
