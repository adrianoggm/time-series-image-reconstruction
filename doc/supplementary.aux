\@writefile{toc}{\contentsline {section}{\numberline {S14}Exploratory MTF sensitivity analyses}{12}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {S15}{\ignorespaces Controlled MTF decoder comparison at $Q=4$ on 100 randomly selected fold-0 windows (seed 0, $T=128$). Every variant decodes the identical 8-bit image; MAE (m/s$^2$) and Pearson are averaged across axes.}}{13}{}\protected@file@percent }
\newlabel{tab:supp_mtf_ablation}{{S15}{13}{Exploratory MTF sensitivity analyses}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S16}{\ignorespaces MTF bin-count sensitivity over all pooled windows ($N=8\,172$). Pointwise MAE (m/s$^2$) and Pearson are decoder-only (each window reconstructs identically regardless of fold); the KNN--CNN columns are mean downstream accuracy on the MTF reconstructions at each $Q$ under the window-level 3-fold protocol, using the fixed original-trained models. Highlighting marks the headline $Q=4$ and is descriptive, not nested model selection. Each row re-encodes and re-decodes every window at that $Q$, so the $Q=4$ row is an independent recomputation and reproduces Table~\ref {tab:pointwise_pooled} to within $0.01$\,m/s$^2$ rather than exactly.}}{13}{}\protected@file@percent }
\newlabel{tab:mtf_ablation_q}{{S16}{13}{Exploratory MTF sensitivity analyses}{}{}}
