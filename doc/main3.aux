\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Grouped subject-out three-fold accuracy (primary protocol) for three representative classifiers spanning the families (convolutional, recurrent, classical). Accuracies are rounded to three decimals; the sub-$0.001$ per-method differences are quantified per subject in Table~\ref {tab:equivalence_ci}. All six classifiers and the window-level comparison are in the Supplementary Material.}}{21}{}\protected@file@percent }
\newlabel{tab:subject_out_acc}{{5}{21}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Subject-level classification equivalence under grouped subject-out validation. The primary family comprises 18 simultaneous subject-cluster bootstrap intervals (six classifiers by RP/GASF/GADF); the six MTF negative-control comparisons form a separate family (51 subjects, \(10^4\) joint resamples per family). For each method, ``most boundary-near'' is the single simultaneous interval whose endpoint lies closest to the equivalence margin, with the classifier it comes from; all 24 individual intervals are in the Supplementary Material.}}{21}{}\protected@file@percent }
\newlabel{tab:equivalence_ci}{{6}{21}{}{}{}}
