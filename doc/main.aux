\@writefile{toc}{\contentsline {subsubsection}{\numberline {6.2.1}Pointwise Error Metrics}{26}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Per-fold reconstruction error for both 3-fold protocols (physical units, m/s$^2$). Each cell is the per-window global metric (averaged over the three axes) averaged over that fold's test windows. Because the decoders are deterministic and untrained, a window reconstructs identically in any fold; the two protocols only repartition the same $8172$ windows, so the Pooled column is identical for both and equals the full-dataset value of Table~\ref {tab:pointwise_pooled}. The window-level folds are near-identical stratified partitions (negligible fold-to-fold spread), whereas the subject-out folds vary more because different subjects are held out.}}{27}{}\protected@file@percent }
\newlabel{tab:pointwise_perfold}{{6}{27}{Pointwise Error Metrics}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Pooled pointwise reconstruction errors over all $N=8172$ windows --- the full dataset (the three test folds of either protocol pooled; identical, since both repartition the same windows; physical units, m/s$^2$). This aggregates the per-fold values of Table~\ref {tab:pointwise_perfold}. Because the decoders are deterministic and untrained, the pooled set is the full dataset with each window scored once. Each metric is computed per window (averaged over the three accelerometer axes); columns report the across-window mean$\pm $std and median[IQR], and the subject-cluster bootstrap 95\% CI of the grand per-subject mean ($51$ subjects, $10^4$ resamples). Per-axis breakdowns are in Appendix~\ref {app:per_axis_errors}.}}{28}{}\protected@file@percent }
\newlabel{tab:pointwise_pooled}{{7}{28}{Pointwise Error Metrics}{}{}}
